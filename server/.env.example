PORT=4000
JWT_SECRET=famify_secret_key_local

# Orígenes permitidos para el cliente, separados por coma. Si se deja comentado, se aceptan
# http(s)://localhost:5173 y http(s)://<IP de red>:5173
# CLIENT_URL=https://localhost:5173

# Base de Datos Local Postgres
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=famify

# Credenciales SMTP de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion

# RNF02: HTTPS/TLS. npm run tls:generar crea un certificado de desarrollo en server/certs
TLS_CERT=certs/famify.crt
TLS_KEY=certs/famify.key
# Puerto HTTP que solo redirige a HTTPS (opcional)
HTTP_REDIRECCION_PUERTO=4080
# true rechaza cualquier petición que no llegue por HTTPS (en NODE_ENV=production siempre se rechaza)
# TLS_OBLIGATORIO=true

# RNF14: respaldo automático diario con pg_dump (activo por defecto; false lo apaga)
RESPALDOS_ACTIVOS=true
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# RESPALDOS_DIR=C:/ruta/respaldos
