PORT=4000
JWT_SECRET=famify_secret_key_local

# Orígenes permitidos para el cliente, separados por coma
CLIENT_URL=http://localhost:5173

# Base de Datos Local Postgres
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=famify

# Credenciales SMTP de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion

# RNF02: rutas al certificado para atender por HTTPS (opcional en desarrollo)
# TLS_CERT=certs/famify.crt   (npm run tls:generar crea uno de desarrollo)
# TLS_KEY=certs/famify.key

# RNF14: respaldo automático diario con pg_dump (activo por defecto; false lo apaga)
RESPALDOS_ACTIVOS=true
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# RESPALDOS_DIR=C:/ruta/respaldos
