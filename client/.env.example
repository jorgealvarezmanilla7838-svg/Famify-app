# Dirección del servidor. Si se deja comentada, el cliente pide /api a su propio origen y Vite lo reenvía
# al backend (un solo certificado que aceptar). En producción debe ser https (RNF02).
# VITE_API_URL=https://localhost:4000

# RNF31: datos del responsable que aparecen en el aviso de privacidad (opcionales)
# VITE_AVISO_RESPONSABLE=Nombre del responsable
# VITE_AVISO_DOMICILIO=Calle, número, colonia, C.P., ciudad, estado
# VITE_AVISO_CORREO=correo@dominio.com
